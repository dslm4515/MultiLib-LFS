# Final System - GMP
# Build and install under chroot

# NOTE: The default settings of GMP produce libraries optimized 
# for the host processor. If libraries suitable for processors 
# less capable than the host's CPU are desired, generic libraries 
# can be created by appending the --host=none-linux-gnu option 
# to the configure command. 

# First, make an adjustment for compatibility with gcc-15 and 
# later:
sed -i '/long long t1;/,+1s/()/(...)/' configure

# Set build options
export  CARGS="--prefix=/usr "
export CARGS+="--enable-cxx "
export CARGS+="--disable-static "
export CARGS+="--docdir=/usr/share/doc/gmp-6.3.0 " 

# Prepare GMP for compilation: 
./configure $CARGS

# Compile the package:
make

# Test the results: 
make check 2>&1 | tee gmp-check-log

# Ensure that at least 199 tests in the test suite passed. Check 
# the results by issuing the following command: 
awk '/# PASS:/{total+=$3} ; END{print total}' gmp-check-log

# Install the package: 
make install

## 32-bit Build

# Clean previous build:
make distclean

# Generic libraries can be created by running the following: 
cp -v configfsf.guess config.guess
cp -v configfsf.sub   config.sub

# Set CFLAGS
export  CFLAGS="-m32 -O2 "
export CFLAGS+="-pedantic "
export CFLAGS+="-fomit-frame-pointer "
export CFLAGS+="-mtune=generic -march=i686 "

# Add 32-bit options for build
export CARGS+="--host=i686-pc-linux-gnu "
export CARGS+="--libdir=/usr/lib32 "
export CARGS+="--includedir=/usr/include/m32/gmp "

# Prepare GMP for 32-bit build
ABI="32" CFLAGS="$CFLAGS"  CXXFLAGS="$CFLAGS" \
PKG_CONFIG_PATH="/usr/lib32/pkgconfig" \
./configure $CARGS

# Compile the package:
sed -i 's/$(exec_prefix)\/include/$\(includedir\)/' Makefile
make

# Test the results: 
make check 2>&1 | tee gmp-check-log

# Ensure that all 199 tests in the test suite passed. Check the 
# results by issuing the following command: 
awk '/# PASS:/{total+=$3} ; END{print total}' gmp-check-log

# Install the package: 
make DESTDIR=$PWD/DESTDIR install
cp -Rv DESTDIR/usr/lib32/* /usr/lib32
cp -Rv DESTDIR/usr/include/m32/* /usr/include/m32/
rm -rf DESTDIR

# Unset compiler flags
unset CFLAGS CXXFLAGS
