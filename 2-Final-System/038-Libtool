# Final System - Libtool
# Build and install under chroot

# Prepare libtool for 64-bit compilation: 
./configure --prefix=/usr

# Compile the package:
make 

# To test the results, issue: 
make check

# Install the package: 
make install

## 32-bit Libtool

# Clean the previous build
make distclean

# Prepare libtool for 32-bit compilation:
export  CARGS="--prefix=/usr "
export CARGS+="--host=i686-pc-linux-gnu "
export CARGS+="--libdir=/usr/lib32 "
CC="gcc -m32" ./configure $CARGS
unset CARGS

# Compile the package:
make

# Install the package: 
make DESTDIR=$PWD/DESTDIR install
cp -Rv DESTDIR/usr/lib32/* /usr/lib32
rm -rf DESTDIR

