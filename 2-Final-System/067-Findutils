# Final System - Findutils
# Build and install under chroot

# Prepare findutils for 64-bit compilation: 
./configure --prefix=/usr --localstatedir=/var/lib/locate

# Compile the package:
make 

# To test the results, issue:
chown -R tester .
su tester -c "PATH=$PATH make check -k"

# Install the package: 
make install

