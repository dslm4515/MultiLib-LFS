# Final System - lz4
# Build and install under chroot

# Compile the package: 
make BUILD_STATIC=no PREFIX=/usr

# To test the results, issue: 
make -j1 check

# Install the package: 
make BUILD_STATIC=no PREFIX=/usr install

## 32-bit lz4 libraries

# Clean previous build: 
make clean

# Compile the package: 
CC="gcc -m32" make BUILD_STATIC=no

# Install the package: 
make BUILD_STATIC=no   \
     PREFIX=/usr       \
     LIBDIR=/usr/lib32 \
     DESTDIR=$(pwd)/m32 install
cp -a m32/usr/lib32/* /usr/lib32/


