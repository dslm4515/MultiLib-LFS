# Final System - MPC
# Build and install under chroot

# Set build options
export  CARGS="--prefix=/usr "
export CARGS+="--disable-static "
export CARGS+="--docdir=/usr/share/doc/mpc-1.3.1 " 

# Prepare GMP for compilation: 
./configure $CARGS

# Compile the package:
make

# Test the results: 
make check 

# Install the package: 
make install

